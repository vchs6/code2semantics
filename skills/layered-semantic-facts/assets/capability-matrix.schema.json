{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code2semantics.local/schema/capability-matrix.schema.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "information_need_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "output_kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "invocation": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "combinations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "enabled": {
            "type": "boolean"
          },
          "acceptance": {
            "type": "object",
            "properties": {
              "actor": {
                "const": "parser_development"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "actor",
              "evidence"
            ],
            "additionalProperties": false
          },
          "research_basis": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "tool_id",
          "description",
          "information_need_ids",
          "output_kinds",
          "languages",
          "platforms",
          "environment",
          "invocation",
          "combinations",
          "limitations",
          "enabled",
          "research_basis"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "enabled": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "acceptance"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "acceptance"
                ]
              }
            }
          }
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "contract_version",
    "entries"
  ],
  "additionalProperties": false
}
