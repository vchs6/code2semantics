{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code2semantics.local/schema/output-schema.schema.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "catalog_id": {
      "const": "semantic-facts-20261025"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "scope_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "directories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "defaulted": {
          "type": "boolean"
        }
      },
      "required": [
        "scope_id",
        "directories",
        "excludes",
        "defaulted"
      ],
      "additionalProperties": false
    },
    "snapshot_set_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/snapshot_record"
      },
      "minItems": 1
    },
    "target": {
      "$ref": "https://code2semantics.local/schema/contract-format.schema.json#/properties/target"
    },
    "results": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/fact_node"
          },
          {
            "$ref": "#/$defs/subtree_node"
          }
        ]
      },
      "minItems": 0
    },
    "out_of_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_type": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "fact_type",
          "fields",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_type": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "reason": {
            "enum": [
              "insufficient_evidence",
              "unknown",
              "not_applicable",
              "conflict",
              "invalid_reference",
              "stale_snapshot",
              "historical_content_unavailable",
              "production_unavailable",
              "budget_exhausted",
              "no_progress",
              "invalid_premise",
              "coverage_incomplete"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/context"
          },
          "coverage": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/coverage"
          },
          "target": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/selection_target"
          }
        },
        "required": [
          "fact_type",
          "fields",
          "reason",
          "detail",
          "context",
          "coverage",
          "target"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "termination": {
      "enum": [
        "satisfied",
        "no_progress",
        "budget_exhausted",
        "invalid_reference",
        "stale_snapshot",
        "unavailable"
      ]
    },
    "resolved_target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "scope"
            },
            "scope_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "required": [
            "kind",
            "scope_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "node"
            },
            "continuation": {
