{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code2semantics.local/schema/output-schema.schema.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "catalog_id": {
      "const": "semantic-facts-20261025"
    },
    "query": {
      "$ref": "https://code2semantics.local/schema/contract-format.schema.json"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/source"
      },
      "minItems": 1
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/fact_node"
      },
      "minItems": 0
    },
    "direct_nodes": {
      "type": "array",
      "items": {
        "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/direct_inventory"
      },
      "minItems": 0
    },
    "premise_checks": {
      "type": "array",
      "items": {
        "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/premise_check"
      },
      "minItems": 0
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/conflict"
      },
      "minItems": 0
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/gap"
      },
      "minItems": 0
    },
    "out_of_catalog": {
      "type": "array",
      "items": {
        "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/out_of_catalog"
      },
      "minItems": 0
    },
    "termination": {
      "enum": [
        "satisfied",
        "no_progress",
        "budget_exhausted",
        "invalid_reference",
        "unavailable"
      ]
    }
  },
  "required": [
    "contract_version",
    "catalog_id",
    "query",
    "sources",
    "results",
    "direct_nodes",
    "premise_checks",
    "conflicts",
    "gaps",
    "out_of_catalog",
    "termination"
  ],
  "additionalProperties": false
}
