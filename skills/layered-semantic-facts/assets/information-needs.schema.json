{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code2semantics.local/schema/information-needs.schema.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "need_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "fact_type": {
            "enum": [
              "F1",
              "F2",
              "F3",
              "F4",
              "F5",
              "F6",
              "F7",
              "F8",
              "F9",
              "F10",
              "F11",
              "F12",
              "F13",
              "F14",
              "F15",
              "F16",
              "F17",
              "F18"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "subject_requirement": {
            "type": "string",
            "minLength": 1
          },
          "evidence_kinds": {
            "type": "array",
            "items": {
              "enum": [
                "source",
                "manifest",
                "configuration",
                "documentation",
                "observation"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "context_requirement": {
            "type": "string",
            "minLength": 1
          },
          "current_source_requirement": {
            "type": "string",
            "minLength": 1
          },
          "coverage_requirement": {
            "type": "string",
            "minLength": 1
          },
          "production_mode": {
            "enum": [
              "deterministic",
              "cognitive",
              "hybrid"
            ]
          },
          "acceptance_fixture": {
            "type": "string",
            "minLength": 1
          },
          "research_basis": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "languages": {
            "type": "array",
            "items": {
              "enum": [
                "Python",
                "Rust"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "output_kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "candidate_producer_families": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "platforms": {
            "type": "array",
            "items": {
              "enum": [
                "linux",
                "darwin",
                "windows"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "environments": {
            "type": "array",
            "items": {
              "enum": [
                "in-process",
                "subprocess"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "scenario_ids": {
            "type": "array",
            "items": {
              "enum": [
                "S1",
                "S2",
                "S3",
                "S4",
                "S5",
                "S6",
                "S7",
                "S8",
                "S9",
                "S10",
                "S11",
                "S12"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "acceptance_status": {
            "enum": [
              "accepted_initial_slice",
              "research_required"
            ]
          }
        },
        "required": [
          "need_id",
          "fact_type",
          "fields",
          "subject_requirement",
          "evidence_kinds",
          "context_requirement",
          "current_source_requirement",
          "coverage_requirement",
          "production_mode",
          "acceptance_fixture",
          "research_basis",
          "languages",
          "output_kinds",
          "candidate_producer_families",
          "platforms",
          "environments",
          "scenario_ids",
          "limitations",
          "acceptance_status"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "contract_version",
    "needs"
  ],
  "additionalProperties": false
}
