{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code2semantics.local/schema/pipeline.schema.json",
  "$defs": {
    "fact_batch": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "catalog_id": {
          "const": "semantic-facts-20261025"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/source"
          },
          "minItems": 1
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/fact_node"
          },
          "minItems": 0
        },
        "navigation": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/navigation_edge"
          },
          "minItems": 0
        },
        "direct_nodes": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/direct_inventory"
          },
          "minItems": 0
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/conflict"
          },
          "minItems": 0
        }
      },
      "required": [
        "contract_version",
        "catalog_id",
        "sources",
        "facts",
        "navigation",
        "direct_nodes",
        "conflicts"
      ],
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "target",
            "ancestor",
            "direct_nodes"
          ]
        },
        "target": {
          "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/target"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "target",
        "detail"
      ],
      "additionalProperties": false
    },
    "current_source_context": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/source"
          },
          "minItems": 1
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "kind": {
                "enum": [
                  "added",
                  "modified",
                  "deleted"
                ]
              },
              "affected_subjects": {
                "type": "array",
                "items": {
                  "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/subject_ref"
                },
                "minItems": 0
              }
            },
            "required": [
              "source_id",
              "kind",
              "affected_subjects"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "necessary_ancestors": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/node_ref"
          },
          "minItems": 0
        },
        "obligations": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/obligation"
          },
          "minItems": 0
        }
      },
      "required": [
        "sources",
        "changes",
        "necessary_ancestors",
        "obligations"
      ],
      "additionalProperties": false
    },
    "invocation_profile": {
      "type": "object",
      "properties": {
        "tool_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/source"
          },
          "minItems": 1
        },
        "coverage": {
          "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/coverage"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/evidence"
          },
          "minItems": 0
        }
      },
      "required": [
        "tool_id",
        "tool_version",
        "command",
        "environment",
        "sources",
        "coverage",
        "evidence"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "subject": {
          "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/reference"
        },
        "information_need_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "payload": {
          "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/semantic_value"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/evidence"
          },
          "minItems": 1
        },
        "context": {
          "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/context"
        },
        "coverage": {
          "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/coverage"
        }
      },
      "required": [
        "observation_id",
        "subject",
        "information_need_id",
        "payload",
        "evidence",
        "context",
        "coverage"
      ],
      "additionalProperties": false
    },
    "parse_request": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "parse_request"
        },
        "tool_native_output": {
          "type": "object",
          "properties": {
            "encoding": {
              "const": "utf-8"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "encoding",
            "text"
          ],
          "additionalProperties": false
        },
        "invocation_profile": {
          "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/invocation_profile"
        }
      },
      "required": [
        "kind",
        "tool_native_output",
        "invocation_profile"
      ],
      "additionalProperties": false
    },
    "parse_result": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "parse_result"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/observation"
          },
          "minItems": 0
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/gap"
          },
          "minItems": 0
        }
      },
      "required": [
        "kind",
        "observations",
        "gaps"
      ],
      "additionalProperties": false
    },
    "construct_request": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "construct_request"
        },
        "query": {
          "$ref": "https://code2semantics.local/schema/contract-format.schema.json"
        },
        "existing_valid_facts": {
          "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/fact_batch"
        },
        "unmet": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/gap"
          },
          "minItems": 0
        },
        "current_source_context": {
          "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/current_source_context"
        }
      },
      "required": [
        "kind",
        "query",
        "existing_valid_facts",
        "unmet",
        "current_source_context"
      ],
      "additionalProperties": false
    },
    "construct_result": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "construct_result"
        },
        "batch": {
          "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/fact_batch"
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/gap"
          },
          "minItems": 0
        }
      },
      "required": [
        "kind",
        "batch",
        "gaps"
      ],
      "additionalProperties": false
    },
    "induction_request": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "induction_request"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "group": {
          "type": "object",
          "properties": {
            "fact_type": {
              "enum": [
                "F1",
                "F2",
                "F3",
                "F4",
                "F5",
                "F6",
                "F7",
                "F8",
                "F9",
                "F10",
                "F11",
                "F12",
                "F13",
                "F14",
                "F15",
                "F16",
                "F17",
                "F18"
              ]
            },
            "subject": {
              "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/node_ref"
            },
            "content_states": {
              "type": "array",
              "items": {
                "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/source_state"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "context": {
              "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/context"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "fact_type",
            "subject",
            "content_states",
            "context",
            "fields"
          ],
          "additionalProperties": false
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/observation"
          },
          "minItems": 0
        },
        "existing_valid_facts": {
          "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/fact_batch"
        },
        "unmet": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/gap"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "request_id",
        "group",
        "observations",
        "existing_valid_facts",
        "unmet"
      ],
      "additionalProperties": false
    },
    "induction_result": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "induction_result"
        },
        "batch": {
          "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/fact_batch"
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/gap"
          },
          "minItems": 0
        }
      },
      "required": [
        "kind",
        "batch",
        "gaps"
      ],
      "additionalProperties": false
    },
    "stored_record": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "stored_record"
        },
        "batch": {
          "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/fact_batch"
        },
        "transaction_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "kind",
        "batch",
        "transaction_id"
      ],
      "additionalProperties": false
    },
    "read_result": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "read_result"
        },
        "known": {
          "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/fact_batch"
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/gap"
          },
          "minItems": 0
        }
      },
      "required": [
        "kind",
        "known",
        "rejected"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/parse_request"
    },
    {
      "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/parse_result"
    },
    {
      "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/construct_request"
    },
    {
      "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/construct_result"
    },
    {
      "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/induction_request"
    },
    {
      "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/induction_result"
    },
    {
      "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/stored_record"
    },
    {
      "$ref": "https://code2semantics.local/schema/pipeline.schema.json#/$defs/read_result"
    }
  ]
}
