{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code2semantics.local/schema/contract-format.schema.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "catalog_id": {
      "const": "semantic-facts-20261025"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope": {
      "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/scope"
    },
    "target": {
      "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/target"
    },
    "granularity": {
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "selections": {
      "type": "array",
      "items": {
        "$ref": "https://code2semantics.local/schema/common.schema.json#/$defs/selection"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "max_new_assertions": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_rounds",
        "max_new_assertions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "catalog_id",
    "request_id",
    "scope",
    "target",
    "granularity",
    "selections",
    "budget"
  ],
  "additionalProperties": false
}
