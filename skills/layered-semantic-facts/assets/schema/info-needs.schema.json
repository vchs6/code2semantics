{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "信息需求定义（矩阵行维度）",
  "description": "行维度标识为占位格式 need.<fact_type_slug>，待构造器信息需求清单落盘后对齐（design OQ1 / Risks）",
  "type": "object",
  "required": ["schema_version", "identifier_note", "needs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "identifier_note": { "const": "占位标识：need.<事实类型slug>，待 add-semantic-fact-constructor 信息需求清单对齐后统一替换" },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "layer", "fact_type", "required_info", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^need\\.[a-z0-9_.-]+$" },
          "layer": { "enum": ["项目层", "模块层", "符号层", "事实层A", "事实层B"] },
          "fact_type": { "type": "string" },
          "required_info": { "type": "string", "description": "需生产的信息（调研报告第 1 节派生）" },
          "evidence": {
            "type": "object",
            "required": ["source", "line_start", "line_end"],
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string" },
              "line_start": { "type": "integer", "minimum": 1 },
              "line_end": { "type": "integer", "minimum": 1 },
              "note": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
