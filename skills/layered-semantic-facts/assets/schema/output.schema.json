{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "output.schema.json",
  "title": "最小事实集响应（output）",
  "description": "契约查询模式的输出为机器可读 JSON 语义事实集。层级与字段以 fact-catalog.md 为准；gaps 与 out_of_scope 分列。本 schema 定义结构，为机读权威（语言无关）。",
  "type": "object",
  "required": [
    "project",
    "facts",
    "gaps",
    "out_of_scope"
  ],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "string",
      "description": "实际使用的项目根。"
    },
    "project_defaulted": {
      "type": "boolean",
      "description": "true 表示项目位置采用了宿主当前工作目录缺省。"
    },
    "repository_defaulted": {
      "type": "boolean",
      "description": "true 表示事实仓库位置采用了缺省来源（环境变量或固定路径）。"
    },
    "version": {
      "type": "string",
      "description": "真实版本标注：本事实集对应的来源项目版本（Git commit 或本地指纹）。"
    },
    "version_fallback": {
      "type": "boolean",
      "description": "true 表示请求版本在仓库中缺失、已回退至当前版本（MUST NOT 以当前版本冒充请求版本）。"
    },
    "facts": {
      "type": "object",
      "description": "分层事实集，按查询节点下一级返回（最小化）：每条事实为其类型节点的下一级节点集（children），子树节点仅标注不展开，内容由消费方续查。每条事实附源码证据定位。",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "type",
            "children"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "description": "事实类型（属 fact-catalog）。"
            },
            "children": {
              "type": "array",
              "description": "该节点的下一级节点：值属性直出（is_subtree=false，附 value）；子树节点仅标注（is_subtree=true，内容不返回）。",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "is_subtree"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "下一级节点名（fact-catalog 字段）。"
                  },
                  "is_subtree": {
                    "type": "boolean",
                    "description": "是否子树节点：true 时不返回内容，消费方以 path 续查。"
                  },
                  "value": {
                    "description": "值属性值（is_subtree=false 时出现），语言无关描述。"
                  }
                }
              }
            },
            "evidence": {
              "type": "object",
              "required": [
                "file",
                "range"
              ],
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string",
                  "description": "源码文件路径。"
                },
                "range": {
                  "type": "string",
                  "description": "起止行号范围，格式如 12-18。"
                }
              }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "description": "目录内但项目中缺失/无法构造的事实，含原因；MUST NOT 编造填充。",
      "items": {
        "type": "object",
        "required": [
          "type",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "description": "缺失的事实类型。"
          },
          "field": {
            "type": "string",
            "description": "字段级缺失时标注具体字段（可选；缺省为类型级缺失）。"
          },
          "reason": {
            "type": "string",
            "description": "原因（区分：源码与仓库均无信息 / 构造后仍缺失 / 构造器不可用只读降级 / 生产者或解析器不可用）。"
          }
        }
      }
    },
    "out_of_scope": {
      "type": "array",
      "description": "契约引用了目录外事实，显式声明，不产生对应事实内容。",
      "items": {
        "type": "string"
      }
    },
    "induction_requests": {
      "type": "array",
      "description": "待代理归纳请求：无工具直出数据项、但有已点亮智能体兜底/分析Skill生产者的缺失事实类型。每项含事实类型、fact-catalog 字段清单与信息需求指导；由调用方代理按契约归纳后经 inducer 钩子并入。",
      "items": {
        "type": "object",
        "required": [
          "type",
          "fields",
          "guidance"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "description": "事实类型（属 fact-catalog）。"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "该类型的 fact-catalog 可查询字段。"
          },
          "guidance": {
            "type": "string",
            "description": "信息需求清单的 required_info 指导。"
          }
        }
      }
    },
    "info_needs": {
      "type": "object",
      "description": "合成分析产出的信息需求清单（构造器任务 2.3 确定性交付物）：契约要求事实类型 → 所需信息需求；语义归纳类字段不映射为工具信息需求，其生产按生产阶梯由项目分析 Skill / 智能体兜底承担。",
      "additionalProperties": true
    }
  }
}