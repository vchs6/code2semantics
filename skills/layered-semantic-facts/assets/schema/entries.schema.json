{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "生产能力矩阵条目集（信息需求 × 生产者）",
  "description": "条目维度=信息需求×生产者。schema 为唯一校验依据（design 决策 4）。字段命名与枚举以 add-semantic-capability-matrix design 决策 1 为准。",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "矩阵整体修订号，更新脚本每次写入时递增，配合 history/ 留变更痕迹"
    },
    "identifier_note": {
      "type": "string",
      "description": "行维度标识为占位说明（design Risks：信息需求清单落盘前用占位标识）"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "verdict": {
      "description": "判定等级三档（沿用调研 tasks 第 5 条）",
      "enum": [
        "可完成",
        "部分可完成",
        "不可完成"
      ]
    },
    "production_tier": {
      "description": "生产层级三分类（沿用调研 tasks 第 2/3 条生产者分类；最终词汇表待调研回填，design OQ2）",
      "enum": [
        "工具直出",
        "项目分析Skill",
        "智能体兜底"
      ]
    },
    "status": {
      "description": "点亮状态：未点亮=现状缺口记录（不产生待办）；已点亮=解析器已落地、构造器可调用",
      "enum": [
        "未点亮",
        "已点亮"
      ]
    },
    "invocation_profile": {
      "description": "调用剖面（沿用构造器 design 决策 6 的字段构成）；整体结构为占位，待 add-info-parser 注册协议定稿回填（design OQ3）",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structure_placeholder": {
          "const": "待 add-info-parser 注册接口协议定稿回填（design OQ3）"
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "retries": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "parser_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "facet": {
          "type": [
            "string",
            "null"
          ],
          "description": "事实分面：分面型解析器（如 H-ast_grep）按它从匹配中抽取哪一类信息数据项（symbol_relation/call_condition/error_handling/lifecycle_event/element_structure）。"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "description": "分面缺省值补充：当 AST 模式无法捕获枚举字段（如 control_flow_kind）时由剖面提供缺省值。"
        }
      }
    },
    "evidence": {
      "description": "证据引用：指向调研报告（播种）或解析器登记记录（更新）中的真实位置；校验须可回链",
      "type": "object",
      "required": [
        "source",
        "line_start",
        "line_end"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "description": "证据文件仓库相对路径"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "need_id",
        "producer_id",
        "verdict",
        "production_tier",
        "platforms",
        "runtime_guidance",
        "invocation_profile",
        "evidence",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "need_id": {
          "type": "string",
          "pattern": "^need\\.[a-z0-9_.-]+$"
        },
        "producer_id": {
          "type": "string",
          "pattern": "^(H|X|A)-[a-z0-9_-]+$"
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "production_tier": {
          "$ref": "#/$defs/production_tier"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "运行平台（与判定正交，design 决策 2）；播种自 Linux 调研报告时为 [linux]"
        },
        "runtime_guidance": {
          "type": "string",
          "description": "运行指导（如安装/调用注意事项）"
        },
        "invocation_profile": {
          "$ref": "#/$defs/invocation_profile"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    }
  }
}