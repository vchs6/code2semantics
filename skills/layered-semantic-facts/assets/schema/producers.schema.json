{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "生产者定义（宿主工具 / 外部工具 / 智能体形态）",
  "type": "object",
  "required": ["schema_version", "producers"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "producers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(H|X|A)-[a-z0-9_-]+$" },
          "name": { "type": "string" },
          "kind": { "enum": ["host_tool", "external_tool", "agent"] },
          "scale": {
            "description": "规模分级（小型/中型/大型，调研报告 3.1）",
            "enum": ["小型", "中型", "大型", null]
          },
          "languages": {
            "type": "array",
            "items": { "type": "string" },
            "description": "支持语言（多语言/语言无关/语言专属清单）"
          },
          "evidence": {
            "type": "object",
            "required": ["source", "line_start", "line_end"],
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string" },
              "line_start": { "type": "integer", "minimum": 1 },
              "line_end": { "type": "integer", "minimum": 1 },
              "note": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
